NODE_ENV=development
APP_BASE_URL=http://localhost:3000
APPWRITE_ENDPOINT=https://appwrite.example.com/v1
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=pacsm-core
# Local development may point to a protected file outside the repository.
# Coolify should use APPWRITE_PROVISIONING_KEY as a locked runtime secret instead.
APPWRITE_PROVISIONING_KEY=
APPWRITE_PROVISIONING_KEY_FILE=
APPWRITE_AUTH_API_KEY=
APPWRITE_STORAGE_API_KEY=
APPWRITE_DATABASE_API_KEY=
APPWRITE_PRODUCT_MEDIA_BUCKET_ID=
APPWRITE_KYC_BUCKET_ID=
SESSION_COOKIE_NAME=pacsm_session
SESSION_COOKIE_DOMAIN=
LOG_LEVEL=info
