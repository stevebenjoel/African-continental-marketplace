NODE_ENV=development
APP_BASE_URL=http://localhost:3000
APPWRITE_ENDPOINT=https://appwrite.example.com/v1
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=pacsm-core
# Provisioning credentials are for one-off schema maintenance only and stay out of the app runtime.
APPWRITE_PROVISIONING_KEY=
APPWRITE_PROVISIONING_KEY_FILE=
APPWRITE_API_KEY=
APPWRITE_API_KEY_FILE=
APPWRITE_PRODUCT_MEDIA_BUCKET_ID=
APPWRITE_KYC_BUCKET_ID=
SESSION_COOKIE_NAME=pacsm_session
# PAC-SM uses a host-only session cookie. Do not configure a cookie domain.
LOG_LEVEL=info
PAYSTACK_SECRET_KEY=
# Server-only transactional email configuration. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
RESEND_FROM_EMAIL="PAC-SM <notifications@mail.africancontinentalmarketplace.store>"
RESEND_REPLY_TO_EMAIL=
# Server-only AI drafting configuration. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_PRODUCT_DRAFT_MODEL=gpt-5.4-mini
